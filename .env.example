# Copy this file to .env on the server. No rebuild needed after changing these values — just restart PM2.

# Port the Next.js server listens on
PORT=3000

# Runtime config — injected into every page by the server at request time.
API_BASE=https://your-backend.example.com/api
IMG_BASE=https://your-backend.example.com

# Build-time fallbacks (keep in sync with the above; used only when the server is not running)
NEXT_PUBLIC_API_BASE=https://your-backend.example.com/api
NEXT_PUBLIC_IMG_BASE=https://your-backend.example.com

# S3 bucket hostname for Next.js Image optimisation (hostname only, no protocol)
NEXT_PUBLIC_S3_HOSTNAME=your-bucket.s3.ap-southeast-2.amazonaws.com
