# Copy this file to .env and fill in the values before building.

# Port the Next.js server listens on
PORT=3000

# Backend API base URL (must include /api)
NEXT_PUBLIC_API_BASE=https://your-backend.example.com/api

# Backend image/media base URL (no trailing slash)
NEXT_PUBLIC_IMG_BASE=https://your-backend.example.com

# S3 bucket hostname for Next.js Image optimisation (hostname only, no protocol)
NEXT_PUBLIC_S3_HOSTNAME=your-bucket.s3.ap-southeast-2.amazonaws.com
